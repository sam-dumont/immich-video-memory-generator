# Authentication is disabled by default: anyone who reaches the UI can use it.
# Enable auth first (IMMICH_MEMORIES_AUTH_USERNAME/PASSWORD in the Secret, or
# OIDC), then: cp ingress.yaml.example ingress.yaml, edit the host, and add
# `- ingress.yaml` to kustomization.yaml.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: immich-memories
  namespace: immich-memories
  labels:
    app.kubernetes.io/name: immich-memories
  annotations:
    # nginx.ingress.kubernetes.io/proxy-body-size: "0"
    # cert-manager.io/cluster-issuer: "letsencrypt-prod"
spec:
  ingressClassName: nginx  # or traefik, etc.
  rules:
    - host: memories.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: immich-memories
                port:
                  name: http
  # tls:
  #   - hosts:
  #       - memories.example.com
  #     secretName: immich-memories-tls

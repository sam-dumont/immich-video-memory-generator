# Immich Memories — the inference service
#
# One Dockerfile, two images: `cpu` (linux/amd64 + linux/arm64) and `cuda`
# (linux/amd64). The shape is immich-machine-learning's — builder-${DEVICE} →
# prod-${DEVICE} → prod — so the variants cannot drift apart, and the tags read
# the way immich's do: `:X.Y.Z` and `:X.Y.Z-cuda`.
#
#   docker build -f docker/Dockerfile.inference --build-arg DEVICE=cpu \
#     --build-arg APP_VERSION=X.Y.Z -t ghcr.io/…/inference:X.Y.Z .
#   docker build -f docker/Dockerfile.inference --build-arg DEVICE=cuda \
#     --build-arg APP_VERSION=X.Y.Z -t ghcr.io/…/inference:X.Y.Z-cuda .
#
# CUDA includes every small-model weight and the caption runtime. CPU keeps
# the smaller image and fetches weights into /cache when downloads are enabled.

ARG DEVICE=cpu
# WHY digests: a mutable tag is a supply-chain hole, and the app image pins the
# same python base — bump the two together.
ARG PYTHON_BASE=python:3.11-slim@sha256:b1b81d67b8df73bf6067191790c233ef9e598b863fc1ccf447956138ca466d99
# Must provide CUDA 12 and cuDNN 9: that is what the onnxruntime-gpu wheels are
# built against.
ARG CUDA_BASE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04@sha256:ac55d124da4882b497f732d8dfd9a702d5447a5f29d08d56da6f64f0a1eb34bc

ARG CAPTION_RUNTIME=ghcr.io/ggml-org/llama.cpp:server-cuda-b10920@sha256:6b4e57594fbb8fb1111bfe64a470570586bb4649a1d38647680a4ec3ed159695

FROM ${CAPTION_RUNTIME} AS caption-runtime

# ─── builders ────────────────────────────────────────────────────────────────
FROM ${PYTHON_BASE} AS builder-cpu

ENV INFERENCE_EXTRA=editorial
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*


FROM ${CUDA_BASE} AS builder-cuda

# The CUDA images ship no Python at all.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-dev \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*
# The device extra locks a CUDA 12 / cuDNN 9-compatible runtime.
ENV INFERENCE_EXTRA=editorial-cuda


FROM builder-${DEVICE} AS builder

WORKDIR /app

COPY pyproject.toml README.md uv.lock ./
COPY src/ ./src/
COPY packages/ ./packages/
COPY docker/uv-requirements.txt ./docker/uv-requirements.txt

# hatch-vcs reads the version from git history, which a build context has not
# got. The caller states the release identity instead.
ARG APP_VERSION
RUN if [ -z "${APP_VERSION}" ]; then echo "APP_VERSION build argument is required" >&2; exit 1; fi
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${APP_VERSION}

# uv lives in its own environment so it is not part of what ships: /opt/venv is
# copied into the runtime image whole.
# WHY constraints from uv.lock (#345): a bare `pip install` re-resolves every
# dependency at build time, so the image could ship a set CI never tested —
# that is how OpenCV 5 landed in a release (#339/#340).
RUN python3 -m venv /opt/uv && \
    /opt/uv/bin/pip install --no-cache-dir --require-hashes -r docker/uv-requirements.txt && \
    /opt/uv/bin/uv export --frozen --extra "${INFERENCE_EXTRA}" --no-emit-project \
        --no-emit-package immich-memories-music \
        --format requirements-txt -o /deps-hashes.txt

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

# Both detector seats are ONNX. Install exactly one runtime distribution through
# the selected extra, constrained by the lock; never overwrite the same package
# files by installing CPU and GPU wheels together. The lock export is scoped to
# that extra and carries the wheel hashes, so every dependency download is
# digest-checked, not just version-pinned. A local source tree has no hash to
# check, so the project is built to a wheel and that wheel installed with
# --no-deps: the extra only ever selected dependencies, and those are in already.
RUN pip install --no-cache-dir --require-hashes -r /deps-hashes.txt && \
    pip wheel --no-cache-dir --no-deps --wheel-dir=/project-wheel . && \
    pip install --no-cache-dir --no-deps /project-wheel/*.whl && \
    pip check


FROM builder AS bundled-cuda-models
RUN python -m immich_memories.model_bundle /opt/immich-models


# ─── runtime ─────────────────────────────────────────────────────────────────
FROM ${PYTHON_BASE} AS prod-cpu
ENV IMMICH_MEMORIES_INFERENCE_DETECTOR_CACHE_DIR=/cache/huggingface


FROM ${CUDA_BASE} AS prod-cuda
# The virtual environment copied below refers to its interpreter by path, and
# the CUDA images ship none. Same base as the builder, so same interpreter.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=bundled-cuda-models /opt/immich-models /opt/immich-models
COPY --from=caption-runtime /app /opt/llama
COPY docker/licenses/llama.cpp.LICENSE /opt/llama/LICENSE
COPY docker/captioner-bundled.sh /usr/local/bin/immich-memories-captioner
RUN chmod 755 /usr/local/bin/immich-memories-captioner
ENV LD_LIBRARY_PATH=/opt/llama:/usr/local/cuda/lib64
ENV IMMICH_MEMORIES_INFERENCE_ENCODER=/opt/immich-models/dinov2-small.onnx
ENV IMMICH_MEMORIES_INFERENCE_MARQO_ONNX=/opt/immich-models/nsfw-marqo-384.onnx
ENV IMMICH_MEMORIES_INFERENCE_DETECTOR_CACHE_DIR=/opt/immich-models/huggingface
ENV IMMICH_MEMORIES_INFERENCE_PROVIDER=cuda
ENV IMMICH_MEMORIES_TRIAGE__ENCODER=/opt/immich-models/dinov2-small.onnx
ENV IMMICH_MEMORIES_TRIAGE__PROVIDER=cuda
ENV IMMICH_MEMORIES_EDITORIAL__PREPARATION__MARQO_ONNX=/opt/immich-models/nsfw-marqo-384.onnx
ENV IMMICH_MEMORIES_EDITORIAL__PREPARATION__DETECTOR_CACHE_DIR=/opt/immich-models/huggingface
ENV IMMICH_MEMORIES_EDITORIAL__LAYA_CHECKPOINT=/opt/immich-models/laya
ENV IMMICH_MEMORIES_EDITORIAL__LAYA_AUDIENCE_THRESHOLD=0.185
ENV HF_HUB_OFFLINE=1
# The pinned caption runtime can JIT for older cards: keep the
# driver's JIT cache on the model-cache volume so it outlives the container,
# bounded at 512 MB because an unbounded cache on a NAS or a shared node is how
# a disk-pressure eviction happens. Inert on the cpu variant, so it is set here.
ENV CUDA_CACHE_PATH=/cache/cuda-jit
ENV CUDA_CACHE_MAXSIZE=536870912


FROM prod-${DEVICE} AS prod

ARG APP_VERSION
ARG VCS_REF=unknown
ARG SOURCE_URL=https://github.com/sam-dumont/immich-video-memory-generator

LABEL maintainer="Immich Memories Contributors"
LABEL description="Head and detector facts for Immich Memories, as a service"
LABEL org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="${SOURCE_URL}"

WORKDIR /app

# OpenCV is in the application's dependency set, and it dlopens these two.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
# The service is not a distribution: it imports the application package, which
# is what makes a fact computed here indistinguishable from one computed in
# process. It travels as source on PYTHONPATH.
COPY services/inference /app/services/inference
COPY THIRD_PARTY_NOTICES /usr/share/licenses/immich-memories/THIRD_PARTY_NOTICES

# UID/GID 1000 on purpose: it matches the app image, the first Linux user on
# most home servers, and the shipped Kubernetes manifests (runAsUser: 1000).
RUN existing_group="$(getent group 1000 | cut -d: -f1)" && \
    if [ -n "$existing_group" ]; then groupmod -n immich "$existing_group"; \
    else groupadd -g 1000 immich; fi && \
    existing_user="$(getent passwd 1000 | cut -d: -f1)" && \
    if [ -n "$existing_user" ]; then \
        usermod -l immich -d /home/immich -m -g immich "$existing_user"; \
    else useradd -u 1000 -g immich -d /home/immich -m immich; fi && \
    mkdir -p /cache && chown -R immich:immich /cache

ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/services/inference
# Published on the port `caption_base_url` already defaults to, and reachable:
# the service's own default is loopback so an unconfigured laptop run does not
# put a model server on the LAN, which is not what a container wants.
ENV IMMICH_MEMORIES_INFERENCE_HOST=0.0.0.0
ENV IMMICH_MEMORIES_INFERENCE_PORT=8092
ENV IMMICH_MEMORIES_INFERENCE_CACHE_DIR=/cache

USER immich

EXPOSE 8092

# No curl in either base; python is right there.
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8092/health')" || exit 1

CMD ["python", "-m", "immich_memories_inference"]

{
 "_comment": "The family Immich's settings that shape what a library holds (ML models and thresholds, previews, video transcoding, metadata, geocoding, job concurrency, storage layout), exported 2026-09-25. Applied to every public E2E Immich so households are read the way the owner's library is. Left out: domain, logins, OAuth, mail, templates, backups, library scans, map, theme, ML URL. Hardware transcoding is off: test hosts have no GPU.",
 "machineLearning": {
  "clip": {
   "enabled": true,
   "modelName": "ViT-L-14-quickgelu__dfn2b"
  },
  "duplicateDetection": {
   "enabled": true,
   "maxDistance": 0.01
  },
  "enabled": true,
  "facialRecognition": {
   "enabled": true,
   "maxDistance": 0.4,
   "minFaces": 3,
   "minScore": 0.6,
   "modelName": "antelopev2"
  },
  "ocr": {
   "enabled": true,
   "maxResolution": 768,
   "minDetectionScore": 0.5,
   "minRecognitionScore": 0.8,
   "modelName": "PP-OCRv5_mobile"
  }
 },
 "image": {
  "colorspace": "p3",
  "extractEmbedded": false,
  "fullsize": {
   "enabled": false,
   "format": "jpeg",
   "progressive": false,
   "quality": 80
  },
  "preview": {
   "format": "jpeg",
   "progressive": false,
   "quality": 80,
   "size": 1440
  },
  "thumbnail": {
   "format": "webp",
   "progressive": false,
   "quality": 80,
   "size": 480
  }
 },
 "ffmpeg": {
  "accel": "disabled",

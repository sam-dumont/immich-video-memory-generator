# Copy this file to terraform.tfvars and fill in your values

# Kubernetes
kubeconfig_path    = "~/.kube/config"
kubeconfig_context = "production-cluster"
namespace          = "immich-memories"
environment        = "production"

# Image — production pins a release rather than tracking `latest`. Published tags carry no
# `v` prefix: release `vX.Y.Z` is image tag `X.Y.Z`. Pick the one you want from
# https://github.com/sam-dumont/immich-video-memory-generator/releases
image_tag = "replace-with-a-release-tag"

# Immich
immich_url     = "https://photos.example.com"
immich_api_key = "your-immich-api-key"

# UI authentication — the ingress exposes the UI, so this is required
auth_username = "admin"
auth_password = "change-me"

# Optional: LLM clip content analysis (any OpenAI-compatible API)
llm_base_url = "http://ollama.ollama.svc.cluster.local:11434/v1"
llm_model    = "qwen2.5-vl"
llm_api_key  = ""

# GPU (optional)
gpu_enabled = false
gpu_count   = 1

# Storage
storage_class_name = "local-path" # Or your storage class

# Ingress
ingress_host = "memories.example.com"

# Timezone for the daily automation
timezone = "Europe/Brussels"

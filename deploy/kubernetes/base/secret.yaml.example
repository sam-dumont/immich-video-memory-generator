# cp secret.yaml.example secret.yaml && edit. secret.yaml is gitignored.
# Every key becomes an environment variable in the pod (envFrom), so any
# IMMICH_MEMORIES_* setting that is secret can live here too.
apiVersion: v1
kind: Secret
metadata:
  name: immich-memories-secrets
  namespace: immich-memories
  labels:
    app.kubernetes.io/name: immich-memories
type: Opaque
stringData:
  # In-cluster Immich: http://immich-server.<namespace>.svc.cluster.local:2283
  IMMICH_URL: "https://photos.example.com"
  IMMICH_API_KEY: "your-immich-api-key-here"
  # Optional: API key for an OpenAI-compatible LLM (clip content analysis)
  # IMMICH_MEMORIES_LLM__API_KEY: ""
  # Optional: fixed web-UI session secret (auto-generated on the data volume otherwise)
  # IMMICH_MEMORIES_STORAGE_SECRET: ""
  # Optional: basic auth for the UI (needed before exposing it via Ingress)
  # IMMICH_MEMORIES_AUTH_USERNAME: ""
  # IMMICH_MEMORIES_AUTH_PASSWORD: ""

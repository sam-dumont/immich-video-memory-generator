# Copy this file to .env, beside docker-compose.yml, and fill it in.
# docker compose reads .env by itself, and docker-compose.yml hands each value
# below to the container. After an edit, `docker compose up -d` recreates it.
# Every variable, with its default:
# https://sam-dumont.github.io/immich-video-memory-generator/docs/run/environment-variables

# Where Immich answers, as seen from inside this container. Never localhost:
# in a container that is the container itself. Use your NAS or server address,
# or http://immich-server:2283 when this service sits in Immich's own compose file.
IMMICH_URL=http://192.168.1.10:2283

# Immich > Account Settings > API Keys > New API Key. "All" works; the minimal
# permission list is on the Docker page.
IMMICH_API_KEY=

# Your home, in decimal degrees (right-click it in any map app to copy them).
# Without it no day counts as away from home, so a two-week holiday is cut week
# by week instead of as one trip. Leave them empty to set them later.
IMMICH_MEMORIES_TRIPS__HOMEBASE_LATITUDE=
IMMICH_MEMORIES_TRIPS__HOMEBASE_LONGITUDE=

# The time zone the daily automation's clock and the logs use.
TZ=Etc/UTC

# Basic auth for the web UI. Set both before you publish port 8080 to your
# network (the app holds a key to your whole library). Either one alone is ignored.
# IMMICH_MEMORIES_AUTH_USERNAME=
# IMMICH_MEMORIES_AUTH_PASSWORD=

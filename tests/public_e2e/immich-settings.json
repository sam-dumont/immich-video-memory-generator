   "h264"
  ],
  "bframes": -1,
  "cqMode": "auto",
  "crf": 23,
  "gopSize": 0,
  "maxBitrate": "0",
  "preset": "ultrafast",
  "realtime": {
   "enabled": false,
   "resolutions": [
    480,
    720,
    1080
   ],
   "videoCodecs": [
    "h264",
    "hevc"
   ]
  },
  "refs": 0,
  "targetAudioCodec": "aac",
  "targetResolution": "1080",
  "targetVideoCodec": "h264",
  "temporalAQ": true,
  "threads": 0,
  "tonemap": "hable",
  "transcode": "optimal",
